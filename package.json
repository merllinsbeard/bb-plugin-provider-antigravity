{
  "name": "bb-plugin-provider-antigravity",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Runs Google Antigravity over ACP with multi-account quota pooling, per-account proxies, and live usage reporting.",
  "repository": {
    "type": "git",
    "url": "https://github.com/merllinsbeard/bb-plugin-provider-antigravity.git"
  },
  "keywords": [
    "bb-plugin"
  ],
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.179"
  },
  "bb": {
    "name": "Google Antigravity Provider",
    "description": "Runs Google Antigravity over ACP and reports live account quota via the documented agy CLI.",
    "branding": {
      "icon": "./icons/antigravity.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build ."
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.179",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
