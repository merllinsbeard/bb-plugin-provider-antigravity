#!/bin/sh
here=$(dirname "$0")
state="$HOME/.gemini/antigravity-cli"
name=$(cat "$state/fake-name" 2>/dev/null || echo default)
egress=""
[ -n "${HTTPS_PROXY:-}${HTTP_PROXY:-}" ] && egress="|account=$name|https_proxy=$HTTPS_PROXY|http_proxy=$HTTP_PROXY|no_proxy=$NO_PROXY"
[ -n "$AGY_FAKE_LOG" ] && printf '%s|marker=%s%s\n' "$*" "$BB_PROBE_MARKER" "$egress" >> "$AGY_FAKE_LOG"
if [ "$1" = "--version" ]; then
  echo "1.5.15"
  exit 0
fi
if [ "$1" = "acp" ]; then
  printf 'account=%s pid=%s machine=%s args=%s%s\n' "$name" "$$" "$(cat /etc/machine-id 2>/dev/null)" "$*" "$egress"
  if [ "$AGY_FAKE_MODE" = "rewrite-id" ]; then
    { echo 00000000000000000000000000000000 > "$state/agy-pool-machine-id"; } 2>/dev/null || echo "rewrite refused"
  fi
  if [ "$AGY_FAKE_MODE" = "serve" ]; then
    trap 'echo "term $(cat "$state/fake-name" 2>/dev/null || echo default)" >> "$AGY_FAKE_LOG"; exit 0' TERM
    # Like agy, stop when the client closes stdin: the relay runs bwrap in its own
    # process group, so a killed relay reaches this process only through that EOF.
    exec 3<&0
    cat <&3 >/dev/null &
    wait $!
    exit 0
  fi
  cat
  exit "${AGY_FAKE_EXIT:-0}"
fi
# A print-mode prompt (not the /usage probe): an account whose fake-print says
# "quota" refuses it the way agy 1.5 does (exit 3, JSON error, "Resets in").
# "throttle" is a short rate limit: RESOURCE_EXHAUSTED with no reset.
if [ "$1" = "-p" ] && [ "$2" != "/usage" ]; then
  if [ "$(cat "$state/fake-print" 2>/dev/null)" = "throttle" ]; then
    echo '{"status":"ERROR","response":"","error":"429 RESOURCE_EXHAUSTED: too many requests, try again later."}'
    exit 3
  fi
  if [ "$(cat "$state/fake-print" 2>/dev/null)" = "quota" ]; then
    echo '{"status":"ERROR","response":"","error":"Individual quota reached. Please upgrade your subscription to increase your limits. Resets in 2h0m0s."}'
    echo 'error: Individual quota reached. Please upgrade your subscription to increase your limits. Resets in 2h0m0s.' >&2
    exit 3
  fi
  printf '{"status":"SUCCESS","response":"ran on %s"}\n' "$name"
  exit 0
fi
[ -n "${AGY_FAKE_DELAY:-}" ] && sleep "$AGY_FAKE_DELAY"
case "$AGY_FAKE_MODE" in
  auth)
    echo "Authentication required. Opening browser to sign in..." >&2
    exec sleep 30
    ;;
  hang) exec sleep 30 ;;
  flood) head -c 100000 /dev/zero; exec sleep 30 ;;
  fail) echo "starting" >&2; echo "backend unavailable" >&2; exit 3 ;;
  prompt) echo '{"status":"SUCCESS","response":"Here is your usage.","num_turns":1}' ;;
  stdin) cat > /dev/null; cat "$here/../../../usage-live.json" ;;
  *) if [ -f "$state/fake-usage.json" ]; then cat "$state/fake-usage.json"; else cat "$here/../../../usage-live.json"; fi ;;
esac
