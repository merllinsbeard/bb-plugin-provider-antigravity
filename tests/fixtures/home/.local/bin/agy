#!/bin/sh
here=$(dirname "$0")
[ -n "$AGY_FAKE_LOG" ] && printf '%s|marker=%s\n' "$*" "$BB_PROBE_MARKER" >> "$AGY_FAKE_LOG"
if [ "$1" = "--version" ]; then
  echo "1.5.15"
  exit 0
fi
case "$AGY_FAKE_MODE" in
  auth)
    echo "Authentication required. Opening browser to sign in..." >&2
    exec sleep 30
    ;;
  hang) exec sleep 30 ;;
  flood) head -c 100000 /dev/zero; exec sleep 30 ;;
  fail) echo "starting" >&2; echo "backend unavailable" >&2; exit 3 ;;
  prompt) echo '{"status":"SUCCESS","response":"Here is your usage.","num_turns":1}' ;;
  stdin) cat > /dev/null; cat "$here/../../../usage-live.json" ;;
  *) cat "$here/../../../usage-live.json" ;;
esac
