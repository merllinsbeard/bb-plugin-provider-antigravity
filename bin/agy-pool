#!/usr/bin/env bash
set -euo pipefail
pool_dir="$(dirname "$(readlink -f "$0")")/../src/pool"
cli="$pool_dir/cli.ts"

launch() {
  local -a lines
  mapfile -t lines <<<"$1"
  shift
  local i=0
  while [[ ${lines[i]} != -- ]]; do
    export "${lines[i]}"
    i=$((i + 1))
  done
  exec "${lines[@]:i+1}" "$@"
}

case "${1:-}" in
  list) exec node "$cli" list ;;
  login)
    prefix=$(node "$cli" prepare-login "${@:2}")
    launch "$prefix" acp --login
    ;;
esac

exec node "$pool_dir/relay.ts" "$@"
